{
  "enabled": true,
  "name": "Atualizar o README",
  "description": "Atualizar o README",
  "version": "1.0.0",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Atualize o README do projeto"
  },
  "workspaceFolderName": "kiro-hooks",
  "shortName": "update-readme-on-save"
}